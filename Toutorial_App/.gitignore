# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime / temp files
*.pid
*.seed
*.pid.lock
*.tmp
*.temp

# Uploads / generated assets
server/uploads/*
