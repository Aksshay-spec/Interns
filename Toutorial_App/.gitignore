# Dependencies
node_modules/
Client/node_modules/
server/node_modules/

# Build outputs
Client/dist/
Client/dist-ssr/
server/dist/
coverage/

# Environment files (keep examples)
.env
.env.*
Client/.env
Client/.env.*
server/.env
server/.env.*
